# Backend environment variables
APP_ENV=development
DATABASE_URL=sqlite:///./career_graph.db
JWT_SECRET=super_secret_jwt_signing_key_change_me_in_prod
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOW_ANONYMOUS_DEV_LOGIN=true

# GitHub OAuth credentials (Optional — Personal Access Tokens work without OAuth registration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# AI / LLM API Keys (Optional — system falls back to truthful deterministic grammar heuristics)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Frontend (place in frontend/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# NEXT_PUBLIC_GITHUB_CLIENT_ID=
