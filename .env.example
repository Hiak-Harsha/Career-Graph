# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./career_graph.db
JWT_SECRET=replace-with-a-long-random-secret-before-production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Configure GitHub OAuth before enabling the real sync button in production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# Frontend (place in frontend/.env.local)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
